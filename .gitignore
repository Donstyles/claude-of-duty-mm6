node_modules/
dist/
.vite/
shots/
*.log
.DS_Store
dist-check-*/
.agent-tmp/
reference/mm6/
.env
.env.*
*.key
secrets.json
.secrets
tools/.env

# Generated-art raws: large, regenerable, and derived plates are committed instead.
public/art/**/*.png
!public/art/**/*.plate.png

# Reference screenshots of the game being studied. Kept locally for the art
# review loop; never distributed, because they are somebody else's copyright.
reference/
!reference/NOTES-extra.md

# Byte-cache from importing tools/artpack.py as a module.
__pycache__/
*.pyc

# The plate book is generated: `python3 tools/platebook/build.py` rebuilds it
# from `template.html` plus whatever is in `public/art` right now. Committing the
# 5.9 MB output would be committing a copy of art that is already in the tree,
# and a copy is exactly what went stale last time.
tools/platebook/plate-book.html

# Same rule for the bestiary sheet: `node tools/bestiary.mjs` photographs the
# 99 creatures into `.agent-tmp/bestiary/`, and `python3 tools/bestiary-page.py`
# composes them. Both the shots and the page are derived from the tree, so the
# generators are the thing worth keeping and their output is not.
tools/platebook/bestiary.html
.agent-tmp/
